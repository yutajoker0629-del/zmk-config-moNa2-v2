// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 7
#define SCROLL 8

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};


&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

&trackball {
    automouse-layer = <7>;
    scroll-layers = <8>;
};

/ {
    combos {
        compatible = "zmk,combos";

        layer4_ESC {
            bindings = <&lt 4 ESC>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        attoma-ku {
            bindings = <&kp AT_SIGN>;
            key-positions = <8 9>;
        };

        // 標準(0)から大西(1)へ
        combo_to_onishi {
            timeout-ms = <50>;
            key-positions = <28 27>;
            bindings = <&to_onishi 1>;
            layers = <0 1>;
        };

        // 大西(1)から標準(0)へ
        combo_to_default {
            timeout-ms = <50>;
            key-positions = <4 3>;
            bindings = <&to_default 1>;
            layers = <0 1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // ( ) 用
        parenthesis: parenthesis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp JP_LPAREN &kp JP_RPAREN &kp LEFT_ARROW>;
            label = "parenthesis";
        };

        // 【 】
        brace: brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp JP_LBRACKET &kp JP_RBRACKET &kp LEFT_ARROW>;
            label = "brace";
        };

        alt_tab_stay: alt_tab_stay {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LALT>, <&macro_tap>, <&kp TAB>;
            label = "ALT_TAB_STAY";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <20>;
        };

        // 1回なら丸カッコ、2回なら隅付きカッコ
        td_bracket: td_bracket {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_BRACKET";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&parenthesis>, <&brace>;
        };

        // 1回で「ー」、2回で「～」
        td_prolong: td_prolong {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp MINUS>, <&kp JP_TILDE>;
        };

        // レイヤーを強制的にONにする
        to_onishi: to_onishi {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        // レイヤーを強制的にOFFにする
        to_default: to_default {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: default
        default_layer {
            bindings = <
&lt 3 TAB         &kp W         &kp E    &kp R           &kp T                                                          &kp Y        &kp U    &kp I      &kp O    &kp P
&kp A             &kp S         &kp D    &lt 2 F         &kp G                                  &td_prolong             &kp H        &lt 6 J  &kp K      &kp L    &lt 5 INT4
&mt LEFT_SHIFT Z  &kp X         &kp C    &kp V           &kp B        &kp SPACE                 &td_bracket             &kp N        &kp M    &kp COMMA  &kp DOT  &kp DEL
&kp LCTRL         &kp LEFT_WIN  &kp F16  &kp BACKSPACE   &lt 2 ENTER  &lt_to_layer_0 3 LANG2    &lt_to_layer_0 3 LANG1  &lt 1 SPACE                               &kp LEFT_ALT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        // Layer 1: 大西配列
        oonishi {
            bindings = <
&lt 3 TAB  &kp L         &kp U    &kp COMMA       &kp PERIOD                                                     &kp F        &kp W    &kp R  &kp Y  &kp P
&kp E      &kp I         &kp A    &lt 2 O         &kp H                                  &td_prolong             &kp K        &lt 6 T  &kp N  &kp S  &lt 5 INTERNATIONAL_4
&kp Z      &kp X         &kp C    &kp V           &kp B        &kp SPACE                 &td_bracket             &kp G        &kp D    &kp M  &kp J  &kp DELETE
&kp LCTRL  &kp LEFT_WIN  &kp F16  &kp BACKSPACE   &lt 2 ENTER  &lt_to_layer_0 3 LANG2    &lt_to_layer_0 3 LANG1  &lt 1 SPACE                         &kp LEFT_ALT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        // Layer 2: FUNCTION
        FUNCTION {
            bindings = <
&trans              &trans               &trans     &trans  &trans                                          &trans     &trans         &trans         &trans         &trans
&kp LC(Z)           &kp LC(Y)            &kp LC(Z)  &trans  &trans            &trans                &trans  &kp LC(X)  &kp LC(C)      &kp LC(V)      &kp LC(LS(V))  &kp LC(T)
&kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &trans     &trans  &trans            &trans                &trans  &trans     &kp LC(LA(C))  &kp LA(LC(V))  &trans         &trans
&trans              &trans               &trans     &trans  &kp LA(NUMBER_2)  &kp LA(NUMBER_1)      &trans  &trans                                                  &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        // Layer 3: NUM
        NUM {
            bindings = <
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                                   &kp MINUS  &kp N7        &kp N8        &kp N9        &kp COLON
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &trans         &kp SINGLE_QUOTE  &kp SLASH  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp DOUBLE_QUOTES
&trans   &kp F2   &kp F3   &kp F4   &kp F5   &kp UNDER      &kp PERIOD        &kp N0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH
&trans   &trans   &trans   &trans   &trans   &trans         &trans            &trans                                               &kp PIPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        // Layer 4: BT (ESCコンボで呼び出し)
        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        // Layer 5: ARROW
        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(PAGE_UP)         &kp LG(UP_ARROW)    &kp LC(PAGE_DOWN)        &trans                       &kp LC(LS(LEFT))        &trans          &kp UP_ARROW    &trans           &trans
&alt_tab_stay   &kp LG(LEFT_ARROW)      &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)      &kp END  &trans      &trans  &kp LS(LC(DOWN_ARROW))  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &kp LG(LC(D))       &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &kp LS(LC(RIGHT))       &trans          &trans          &trans           &trans
&trans          &trans                  &trans              &trans                   &trans   &trans      &trans  &trans                                                                   &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        // Layer 6: SCROLL (lt 6 J / lt 6 T で呼び出し)
        SCROLL_LAYER {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        // Layer 7: MOUSE (automouse)
        MOUSE {
            bindings = <
&trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans            &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans    &trans    &trans    &trans  &mkp MB1  &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        // Layer 8: SCROLL (trackball scroll)
        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
